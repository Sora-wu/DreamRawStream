@PACKAGE_INIT@

set(_dream_known_submodules
    MediaNative
    Net
)

foreach(_sub IN LISTS _dream_known_submodules)
    set(_dream_sub_targets "${CMAKE_CURRENT_LIST_DIR}/Dream${_sub}Targets.cmake")
    if(EXISTS "${_dream_sub_targets}")
        include("${_dream_sub_targets}")
    endif()
endforeach()

# 组件 = 具体可用库（target）。存在即标记 FOUND，供 check_required_components 校验。
set(Dream_SUPPORTED_COMPONENTS "")
foreach(_component IN ITEMS Player Recorder Net)
    if(TARGET Dream::${_component})
        set(Dream_${_component}_FOUND TRUE)
        list(APPEND Dream_SUPPORTED_COMPONENTS ${_component})
    endif()
endforeach()

check_required_components(Dream)
